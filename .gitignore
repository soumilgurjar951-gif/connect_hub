# ConnectHub .gitignore
# Hinglish: Ye files git me push nahi hongi (secret / local files)

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.pyo
*.pyd
.Python
env/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Django
db.sqlite3
db.sqlite3-journal
media/
# media ko ignore karo, par .gitkeep rakho taaki folder structure dikhe
!media/.gitkeep
!media/avatars/.gitkeep
!media/post_images/.gitkeep
staticfiles/
*.log
local_settings.py

# Env files - kabhi bhi push mat karo! (Secret key leak ho jayega)
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# Node (agar kabhi frontend tool use karo)
node_modules/
npm-debug.log
yarn-error.log

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
.tox/
coverage.xml
*.cover

# Redis dump (agar local redis use karo)
dump.rdb

# OS
.DS_Store
ehthumbs.db
Desktop.ini
