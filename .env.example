# ConnectHub - Env Example (Real-world public launch)
# copy .env.example .env (Windows: copy .env.example .env)
# .env kabhi git me push mat karo!

# Django — local me True, public me False
SECRET_KEY=django-insecure-change-this-in-production-use-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database — local: khali rakho (SQLite), Railway/Render: DATABASE_URL auto dega
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Prod Security (DEBUG=False pe auto on)
# SECURE_SSL_REDIRECT=True
# Email (prod: SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Media: local MEDIA_ROOT, public me S3/R2 (optional — nahi to Railway pe images delete ho jayenge restart pe)
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional — Redis for Channels
# REDIS_URL=redis://localhost:6379/0
